# Copy to .env.local for local dev (never commit it). On Vercel: Project Settings -> Environment Variables.

# Option A (free, no domain needed): Gmail SMTP
# Gmail -> Google Account -> Security -> turn on 2-Step Verification -> App passwords -> create one
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Where messages should arrive (defaults to SMTP_USER)
CONTACT_TO_EMAIL=

# Option B: Resend (needs a verified domain to email anyone except your own Resend account address)
RESEND_API_KEY=
RESEND_FROM=

# SEO: paste the token from Google Search Console -> HTML tag verification (just the content="..." value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
